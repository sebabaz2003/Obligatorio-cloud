# Archivos temporales de Terraform
**/.terraform/*

# Estado de Terraform
*.tfstate
*.tfstate.*

# Variables que pueden contener credenciales
*.tfvars
*.tfvars.json

# Archivos de planes
*.tfplan

# Claves privadas
*.pem
*.key

# Archivos temporales
.terraform.tfstate.lock.info

# Archivos compilados de la aplicacion
/artifacts/*.war

# Credenciales de AWS y variables de entorno
.aws/
.env
.env.*

# Logs de Terraform
crash.log
crash.*.log